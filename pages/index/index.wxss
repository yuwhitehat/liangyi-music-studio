.home { min-height: 100vh; background: transparent; display: flex; flex-direction: column; }

/* —— 方格纸留白区：云 + 太阳 —— */
.band-sky {
  position: relative; background: transparent;
  height: 190rpx; overflow: hidden;
}
.sky-sun   { width: 76rpx; height: 76rpx; top: 96rpx; right: 160rpx; }
.sky-cloud { width: 130rpx; height: 66rpx; top: 104rpx; left: 40rpx; }

/* —— 标题卡：白卡 + 黑描边 + 黄色错位硬影 —— */
.band-cobalt {
  position: relative; background: #FFFFFF; overflow: hidden;
  margin: 16rpx 64rpx 0;
  border: 6rpx solid #111111;
  border-radius: 44rpx;
  box-shadow: 18rpx 18rpx 0 #FFD23F;
  padding: 40rpx 40rpx 48rpx;
}
.brand-pill {
  display: inline-block; position: relative; z-index: 2;
  background: #111111; color: #FFFFFF;
  font-size: 24rpx; font-weight: 800; letter-spacing: 4rpx;
  border-radius: 999rpx; padding: 12rpx 30rpx;
  margin-bottom: 40rpx;
}
.brand-t {
  position: relative; z-index: 2;
  font-size: 132rpx; font-weight: 900; letter-spacing: 10rpx;
  color: #111111; line-height: 1.22;
}

/* 卡内装饰加号 */
.spark { position: absolute; z-index: 2; font-size: 34rpx; font-weight: 700; color: #111111; }
.sp1 { top: 48rpx;  right: 60rpx; }
.sp2 { top: 250rpx; right: 268rpx; }
.sp3 { bottom: 44rpx; right: 40rpx; }

/* —— 白色地面 —— */
.band-white {
  position: relative; flex: 1; background: transparent;
  padding: 56rpx 40rpx 60rpx;
}

/* —— 左右并排 —— */
.roles { display: flex; gap: 28rpx; position: relative; z-index: 3; }

/* —— 贴纸按钮：白卡 + 黑描边 + 错位硬彩影 —— */
.role {
  flex: 1;
  position: relative;
  height: 300rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  border: 6rpx solid #111111;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 0 40rpx;
  box-shadow: 16rpx 16rpx 0 #4D8DFF;
  transform: translate(0, 0);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s cubic-bezier(.3,.7,.4,1);
}

/* 按下：整块沿影子方向位移，厚度被压扁 */
.role-hover, .role:active {
  transform: translate(8rpx, 8rpx);
  box-shadow: 4rpx 4rpx 0 #4D8DFF;
}

.r-cobalt { box-shadow: 16rpx 16rpx 0 #4D8DFF; }
.r-cobalt.role-hover, .r-cobalt:active { box-shadow: 4rpx 4rpx 0 #4D8DFF; }
.r-terra  { box-shadow: 16rpx 16rpx 0 #FF5FA2; }
.r-terra.role-hover, .r-terra:active { box-shadow: 4rpx 4rpx 0 #FF5FA2; }

.role-t {
  font-size: 40rpx; font-weight: 800; letter-spacing: 5rpx;
  color: #111111;
  position: relative; z-index: 2;
}

/* 箭头装进彩色圆角 chip：颜色只当点缀 */
.role-arrow-wrap {
  width: 108rpx; height: 108rpx; margin-top: 30rpx;
  border-radius: 32rpx;
  border: 5rpx solid #111111;
  background: #4D8DFF;
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 2;
}
.r-terra .role-arrow-wrap { background: #FF5FA2; }
.role-arrow {
  position: relative !important;
  top: auto !important; right: auto !important; bottom: auto !important;
  width: 56rpx; height: 48rpx;
  z-index: 2;
}

/* —— 游客入口：白胶囊 —— */
.guest-link {
  position: relative; z-index: 3;
  margin: 40rpx auto 0; padding: 16rpx 44rpx;
  width: fit-content;
  background: #FFFFFF;
  border: 5rpx solid #111111;
  border-radius: 999rpx;
  font-size: 26rpx; letter-spacing: 2rpx; font-weight: 700;
  color: #111111;
}
