
.rc { position: relative; padding-left: 56rpx; }
.rc-dot {
  position: absolute; left: 40rpx; top: 46rpx;
  width: 24rpx; height: 24rpx; border-radius: 50%; z-index: 2;
  border: 3rpx solid var(--ink);
}
.rc::before {
  content: ''; position: absolute;
  left: 51rpx; top: 46rpx; bottom: -12rpx; width: 4rpx;
  background: rgba(17,17,17,.25);
}
.rc:last-child::before { display: none; }
.rc-item {
  background: #FFFFFF; border: 4rpx solid var(--ink); border-radius: 28rpx;
  padding: 30rpx 32rpx; margin: 0 40rpx 24rpx;
  box-shadow: 8rpx 8rpx 0 var(--blue);
}
.rc-t { font-size: 32rpx; font-weight: 800; color: var(--ink); }
.rc-m { display: block; font-size: 24rpx; color: rgba(17,17,17,.5); margin-top: 12rpx; }

/* ── 我的课时档案 ── */
.enroll {
  margin: 32rpx 40rpx 0; padding: 32rpx;
  background: #FFFFFF; border: var(--bd) solid var(--ink); border-radius: 32rpx;
  box-shadow: 12rpx 12rpx 0 var(--yellow);
}
.en-top { display: flex; }
.en-cell { flex: 1; text-align: center; }
.en-n { display: block; font-size: 52rpx; font-weight: 900; color: var(--ink); line-height: 1; }
.en-hi { color: var(--ink); background: var(--pink); display: inline-block;
  padding: 0 14rpx; border-radius: 100rpx; }
.en-l { display: block; font-size: 21rpx; color: rgba(17,17,17,.5); margin-top: 12rpx; letter-spacing: 1rpx; }

.en-bar { height: 20rpx; border-radius: 100rpx; background: #FFFFFF;
  border: 4rpx solid var(--ink); overflow: hidden; margin-top: 30rpx; }
.en-fill { height: 100%; background: var(--blue); }

.en-date {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 28rpx; padding-top: 26rpx; border-top: 4rpx dashed rgba(17,17,17,.3);
}
.en-dl { font-size: 22rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; flex-shrink: 0; }
.en-dv { font-size: 26rpx; font-weight: 700; color: var(--ink); flex: 1; letter-spacing: .5rpx; }
.en-dd { font-size: 21rpx; font-weight: 700; color: var(--ink); background: var(--yellow);
  border: 3rpx solid var(--ink); padding: 4rpx 16rpx; border-radius: 100rpx; flex-shrink: 0; }

.en-over { color: #C0392B; }
.en-fill-over { background: #C0392B; }
.en-over-tip { margin-top: 16rpx; font-size: 22rpx; color: #C0392B; font-weight: 700; letter-spacing: .5rpx; }
