<view class="page">
  <view class="nav hd-pink">
    <view class="ill ill-dog-w hd-dog"></view>
    <view class="nav-back" bindtap="goBack"></view>
    <view class="nav-h1">上课记录</view>
    <view class="nav-sub">一节一节攒起来的</view>
  </view>

  <!-- 我的课时：一门课一行，收在同一张卡里 -->
  <view class="enroll" wx:if="{{enroll}}">
    <view class="en-h">
      <text class="en-h1">我的课时</text>
      <text class="en-h2" wx:if="{{enroll.rows.length > 1}}">共 {{enroll.rows.length}} 门课</text>
    </view>

    <view class="en-row" wx:for="{{enroll.rows}}" wx:key="courseType">
      <view class="en1">
        <text class="en-c">{{item.courseName}}</text>
        <text class="en-n {{item.over ? 'en-over' : ''}}">
          {{item.over ? '超 ' + item.overBy : (item.hasTotal ? '剩 ' + item.remain : '未填')}}<text class="en-u" wx:if="{{item.hasTotal && !item.over}}"> 节</text>
        </text>
      </view>
      <view class="en-bar" wx:if="{{item.hasTotal}}">
        <view class="en-fill {{item.over ? 'en-fill-over' : ''}}" style="width:{{item.pct}}%"></view>
      </view>
      <view class="en2">
        <text class="en-d">共报 {{item.total}} 节 · 已上 {{item.used}} 节</text>
        <text class="en-tip" wx:if="{{item.over}}">已超支 · 联系老师补充课时</text>
        <text class="en-dd" wx:elif="{{item.days >= 0}}">剩 {{item.days}} 天</text>
      </view>
      <view class="en-span" wx:if="{{item.span}}">{{item.span}}</view>
    </view>

    <view class="en-none" wx:if="{{enroll.rows.length === 0}}">老师还没给你登记报名课程 —— 报好一门课就能约那门课的时段了</view>
  </view>

  <view class="sec"><text class="sec-t">课程记录</text><text class="sec-n">{{records.length}}</text></view>

  <view class="rc" wx:for="{{records}}" wx:key="id">
    <view class="rc-dot" style="background:{{item.bg}}"></view>
    <view class="rc-item">
      <view class="row between">
        <text class="rc-t">{{item.courseName}}</text>
        <text class="tag {{item.statusTag}}">{{item.statusText}}</text>
      </view>
      <text class="rc-m">{{item.friendlyDate}} · {{item.timeSlot}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{records.length === 0}}">
    <view class="empty-c"></view>
    <view class="empty-t">还没有上课记录</view>
  </view>

  <view style="height:60rpx"></view>
</view>
