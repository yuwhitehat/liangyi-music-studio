.hscroll { width: 100%; white-space: nowrap; }
.hrow { display: inline-flex; gap: 18rpx; padding: 0 40rpx 8rpx; }
.hrow .chip { padding: 20rpx 36rpx; }

.bk { display: flex; align-items: stretch; background: #FFFFFF;
  border: var(--bd) solid var(--ink); border-radius: 36rpx; margin: 0 40rpx 28rpx;
  box-shadow: 12rpx 12rpx 0 var(--blue); }
.bk:nth-child(even) { box-shadow: 12rpx 12rpx 0 var(--pink); }
.bk-l { width: 118rpx; flex-shrink: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: var(--ink);
  border-right: 4rpx solid var(--ink); background: var(--sky-lt);
  border-radius: 30rpx 0 0 30rpx; }
.bk-d1 { font-size: 48rpx; font-weight: 900; line-height: 1; }
.bk-d2 { font-size: 22rpx; opacity: .6; margin-top: 10rpx; font-weight: 700; }
.bk-b { flex: 1; min-width: 0; padding: 34rpx 28rpx; }
.bk-t { font-size: 36rpx; font-weight: 800; color: var(--ink); letter-spacing: 2rpx; }
.bk-m { font-size: 26rpx; color: rgba(17,17,17,.5); margin-top: 12rpx; }
.bk-go {
  width: 120rpx; flex-shrink: 0;
  background: var(--pink); color: var(--ink);
  border-left: 4rpx solid var(--ink);
  border-radius: 0 30rpx 30rpx 0;
  font-size: 40rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.bk-go:active { background: var(--yellow); }

.bk-top2 { display: flex; align-items: center; }
.bk-chip { width: 68rpx; height: 68rpx; border-radius: 20rpx; background-color: var(--sky);
  border: 3rpx solid var(--ink); flex-shrink: 0;
  background-repeat: no-repeat; background-position: center; background-size: 44rpx 44rpx; margin-right: 20rpx; }
