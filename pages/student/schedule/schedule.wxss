.chips { margin-top: 32rpx; }
.bk { display: flex; background: #FFFFFF; border: var(--bd) solid var(--ink);
  border-radius: 36rpx; margin: 0 40rpx 28rpx; box-shadow: 12rpx 12rpx 0 var(--blue); }
.bk:nth-child(even) { box-shadow: 12rpx 12rpx 0 var(--pink); }
.bk-l { width: 118rpx; flex-shrink: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: var(--ink);
  border-right: 4rpx solid var(--ink); background: var(--sky-lt);
  border-radius: 30rpx 0 0 30rpx; }
.bk-d1 { font-size: 48rpx; font-weight: 900; line-height: 1; }
.bk-d2 { font-size: 22rpx; opacity: .6; margin-top: 10rpx; font-weight: 700; }
.bk-b { flex: 1; min-width: 0; padding: 34rpx 28rpx; }
.bk-t { font-size: 36rpx; font-weight: 800; color: var(--ink); letter-spacing: 2rpx; }
.bk-m { display: block; font-size: 26rpx; color: rgba(17,17,17,.5); margin-top: 14rpx; }

.occ {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx;
  border-radius: 100rpx; background: var(--sky-lt); border: 3rpx solid var(--ink);
  color: var(--ink); font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
}

/* 逾期：已开课但没人签到 */
.t-over { background: var(--yellow); color: var(--ink); }

/* ── 学员签到 / 取消 ── */
.acts { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ab {
  flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 100rpx; font-size: 26rpx; font-weight: 700; letter-spacing: 1rpx;
  background: #FFFFFF; color: var(--ink); border: 4rpx solid var(--ink);
  box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.18);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s;
}
.ab:active { transform: translate(4rpx,4rpx); box-shadow: 0 0 0 rgba(17,17,17,.18); }
.ab-main { background: var(--pink); box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.3); }
