/* ── 钴蓝顶带 ── */
.lg-top {
  position: relative; padding: 120rpx 40rpx 150rpx;
  overflow: hidden; background: #2B3FA8;
}

.nav-back { position: relative; z-index: 3; margin-bottom: 60rpx; }
.lg-h1 {
  position: relative; z-index: 2; font-size: 84rpx; font-weight: 800;
  letter-spacing: 6rpx; color: #FFFFFF;
}
.lg-sub {
  position: relative; z-index: 2; font-size: 26rpx; letter-spacing: 5rpx;
  color: rgba(255,255,255,.7); margin-top: 16rpx;
}

/* ── 白色表单区 ── */
.lg-form {
  position: relative; z-index: 3;
  padding: 60rpx 40rpx 80rpx;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0; margin-top: -24rpx;
}
.tip {
  font-size: 23rpx; color: rgba(22,36,74,.45);
  margin: -12rpx 0 40rpx; letter-spacing: 1rpx; line-height: 1.7;
}

/* ── 按钮：两个都拉满宽，等长对齐 ── */
.btn-full { width: 100%; box-sizing: border-box; }

.btn-wx { background: #FFFFFF; color: #16244A; border: 3rpx solid #16244A; }
.btn-wx::after { border: none; }
.wx-dot {
  display: inline-block; width: 40rpx; height: 40rpx; line-height: 40rpx;
  border-radius: 50%; background: #E8763A; color: #FFFFFF;
  font-size: 24rpx; margin-right: 18rpx; text-align: center;
}
/* 关键：文字不折行 */
.wx-txt { font-size: 32rpx; letter-spacing: 3rpx; white-space: nowrap; }

/* ── 分隔 ── */
.divider { display: flex; align-items: center; margin: 44rpx 0; color: rgba(22,36,74,.35); font-size: 22rpx; }
.divider::before, .divider::after { content: ''; flex: 1; height: 2rpx; background: #E6ECF6; }
.divider text { padding: 0 28rpx; letter-spacing: 3rpx; }

/* ── 已验证提示 ── */
.matched {
  display: flex; align-items: center; justify-content: space-between;
  background: #EDF6FB; border-radius: 24rpx; padding: 26rpx 32rpx; margin-bottom: 44rpx;
}
.matched-ok { font-size: 26rpx; color: #2B3FA8; font-weight: 700; letter-spacing: 1rpx; }
.matched-no { font-size: 26rpx; color: rgba(22,36,74,.55); letter-spacing: 2rpx; }

/* ── 约克夏：黑色线条，骑在钴蓝/白交界，与首页一致 ── */
.lg-dog {
  width: 210rpx; height: 220rpx;
  right: 36rpx; top: -186rpx;
}

/* ── 回到首页：无箭头，黑色 ── */
.lg-home {
  margin-top: 56rpx; text-align: center; padding: 24rpx;
  font-size: 28rpx; color: #16244A; letter-spacing: 4rpx; font-weight: 700;
}
.lg-switch {
  text-align: center; margin-top: 28rpx;
  font-size: 25rpx; color: rgba(22,36,74,.45); letter-spacing: 2rpx;
}

/* ── 开发期提示卡（DEV_MODE=false 时自动隐藏）── */
.dev {
  background: #F6F8FC; border: 2rpx dashed rgba(43,63,168,.35);
  border-radius: 24rpx; padding: 24rpx 28rpx; margin-bottom: 40rpx;
}
.dev-h { font-size: 22rpx; color: rgba(22,36,74,.45); letter-spacing: 2rpx; margin-bottom: 16rpx; }
.dev-row {
  display: flex; align-items: center; padding: 18rpx 0;
  border-top: 2rpx solid rgba(43,63,168,.1);
}
.dev-tag {
  font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
  padding: 6rpx 16rpx; border-radius: 100rpx; margin-right: 20rpx; flex-shrink: 0;
  background: #D9EAF5; color: #1E2E7A;
}
.dev-tag-super { background: #E8763A; color: #FFFFFF; }
.dev-name { font-size: 27rpx; color: #16244A; font-weight: 600; flex: 1; }
.dev-phone { font-size: 26rpx; color: rgba(22,36,74,.55); letter-spacing: 1rpx; }
