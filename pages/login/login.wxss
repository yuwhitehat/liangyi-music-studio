/* ── 顶部：方格纸留白 + 黑字大标题 ── */
.lg-top {
  position: relative; padding: 120rpx 40rpx 150rpx;
  overflow: hidden; background: transparent;
}

.nav-back { position: relative; z-index: 3; margin-bottom: 60rpx; }
.lg-h1 {
  position: relative; z-index: 2; font-size: 84rpx; font-weight: 900;
  letter-spacing: 6rpx; color: #111111;
}
.lg-sub {
  position: relative; z-index: 2; font-size: 26rpx; letter-spacing: 5rpx;
  color: rgba(17,17,17,.55); margin-top: 16rpx;
}

/* ── 白色表单卡：黑描边 + 粉色错位硬影 ── */
.lg-form {
  position: relative; z-index: 3;
  padding: 60rpx 40rpx 80rpx;
  margin: 0 40rpx 40rpx;
  background: #FFFFFF;
  border: 6rpx solid #111111;
  border-radius: 48rpx;
  box-shadow: 18rpx 18rpx 0 #FF5FA2;
}
.tip {
  font-size: 23rpx; color: rgba(17,17,17,.5);
  margin: -12rpx 0 40rpx; letter-spacing: 1rpx; line-height: 1.7;
}

/* ── 按钮：两个都拉满宽，等长对齐 ── */
.btn-full { width: 100%; box-sizing: border-box; }

.btn-wx { background: #FFFFFF; color: #111111; }
.btn-wx::after { border: none; }
.wx-dot {
  display: inline-block; width: 40rpx; height: 40rpx; line-height: 40rpx;
  border-radius: 50%; background: #FFD23F; color: #111111;
  border: 4rpx solid #111111;
  font-size: 24rpx; margin-right: 18rpx; text-align: center;
}
/* 关键：文字不折行 */
.wx-txt { font-size: 32rpx; letter-spacing: 3rpx; white-space: nowrap; }

/* ── 分隔 ── */
.divider { display: flex; align-items: center; margin: 44rpx 0; color: rgba(17,17,17,.4); font-size: 22rpx; }
.divider::before, .divider::after { content: ''; flex: 1; height: 4rpx; background: #111111; opacity: .12; }
.divider text { padding: 0 28rpx; letter-spacing: 3rpx; }

/* ── 已验证提示 ── */
.matched {
  display: flex; align-items: center; justify-content: space-between;
  background: #FFF8DC; border: 5rpx solid #111111; border-radius: 24rpx;
  padding: 26rpx 32rpx; margin-bottom: 44rpx;
}
.matched-ok { font-size: 26rpx; color: #111111; font-weight: 800; letter-spacing: 1rpx; }
.matched-no { font-size: 26rpx; color: rgba(17,17,17,.55); letter-spacing: 2rpx; }

/* ── 回到首页：无箭头，黑色 ── */
.lg-home {
  margin-top: 56rpx; text-align: center; padding: 24rpx;
  font-size: 28rpx; color: #111111; letter-spacing: 4rpx; font-weight: 800;
}
.lg-switch {
  text-align: center; margin-top: 28rpx;
  font-size: 25rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx;
}

/* ── 开发期提示卡（DEV_MODE=false 时自动隐藏）── */
.dev {
  background: #FFFFFF; border: 4rpx dashed rgba(17,17,17,.4);
  border-radius: 24rpx; padding: 24rpx 28rpx; margin-bottom: 40rpx;
}
.dev-h { font-size: 22rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; margin-bottom: 16rpx; }
.dev-row {
  display: flex; align-items: center; padding: 18rpx 0;
  border-top: 2rpx solid rgba(17,17,17,.12);
}
.dev-tag {
  font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx;
  padding: 6rpx 16rpx; border-radius: 100rpx; margin-right: 20rpx; flex-shrink: 0;
  border: 3rpx solid #111111;
  background: #FFD23F; color: #111111;
}
.dev-tag-super { background: #FF5FA2; color: #111111; }
.dev-name { font-size: 27rpx; color: #111111; font-weight: 700; flex: 1; }
.dev-phone { font-size: 26rpx; color: rgba(17,17,17,.55); letter-spacing: 1rpx; }

/* —— 游客浏览 —— */
.lg-guest {
  text-align: center; margin-top: 18rpx; padding: 16rpx;
  font-size: 24rpx; color: rgba(17,17,17,.45); letter-spacing: 2rpx;
}
