.pf-row { display: flex; align-items: center; margin-top: 50rpx; position: relative; z-index: 2; }
.pf-ava {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #FFFFFF; color: #111111;
  border: 6rpx solid #111111;
  box-shadow: 8rpx 8rpx 0 #FF5FA2;
  font-size: 54rpx; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  margin-right: 28rpx;
}
.pf-name { font-size: 48rpx; font-weight: 900; color: #111111; letter-spacing: 3rpx; }
.pf-role { font-size: 24rpx; color: rgba(17,17,17,.55); margin-top: 10rpx; letter-spacing: 2rpx; }
.pf { margin-top: 36rpx; }
/* 去掉图标后文字垂直居中，卡片不再上虚下重 */
.pf-blk { justify-content: center; }
.pf-foot { text-align: center; padding: 70rpx 0 50rpx; display: flex; flex-direction: column; }
.pf-cn { font-size: 26rpx; letter-spacing: 8rpx; color: #111111; font-weight: 800; }
.pf-en { font-size: 20rpx; letter-spacing: 3rpx; color: rgba(17,17,17,.4); margin-top: 8rpx; }

/* ── 信息弹层：每条独立一行 ── */
.mask { position: fixed; inset: 0; background: rgba(17,17,17,.45); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #FFFFFF; border-top: 6rpx solid #111111;
  border-radius: 40rpx 40rpx 0 0; padding: 44rpx 40rpx 56rpx;
}
.sh-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.sh-t { font-size: 40rpx; font-weight: 900; letter-spacing: 3rpx; color: #111111; }
.sh-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFFFFF; color: #111111;
  border: 5rpx solid #111111; box-shadow: 4rpx 4rpx 0 #111111;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.sh-intro { font-size: 29rpx; color: rgba(17,17,17,.75); line-height: 1.85; letter-spacing: .5rpx;
  padding: 8rpx 0 32rpx; }

.sh-rows { padding: 4rpx 0 8rpx; }
.sh-row {
  display: flex; align-items: flex-start;
  padding: 28rpx 0; border-bottom: 2rpx solid rgba(17,17,17,.12);
}
.sh-row:last-child { border-bottom: none; }
.sh-l { font-size: 25rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; width: 150rpx; flex-shrink: 0; padding-top: 4rpx; }
.sh-v { flex: 1; font-size: 30rpx; font-weight: 700; color: #111111; text-align: right; letter-spacing: .5rpx; }
.sh-v.wrap { line-height: 1.6; word-break: break-all; }
.sh-c { font-size: 20rpx; font-weight: 800; color: #111111; background: #FFF8DC;
  border: 3rpx solid #111111;
  padding: 5rpx 16rpx; border-radius: 100rpx; margin-left: 16rpx; flex-shrink: 0; letter-spacing: 1rpx; }

.sh-tip { font-size: 22rpx; color: rgba(17,17,17,.45); text-align: center; margin: 24rpx 0 28rpx; letter-spacing: 1rpx; }
.sh-ok { margin-top: 8rpx; }
