.nav { padding-bottom: 70rpx; }
.pf-dog { width: 176rpx; height: 185rpx; right: 20rpx; bottom: -8rpx; opacity: .2; }
.pf-cloud { width: 180rpx; height: 90rpx; top: 80rpx; right: 40rpx; opacity: .2; }
.pf-row { display: flex; align-items: center; margin-top: 50rpx; position: relative; z-index: 2; }
.pf-ava {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #EDF6FB; color: #2B3FA8;
  font-size: 54rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-right: 28rpx;
}
.pf-name { font-size: 48rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 3rpx; }
.pf-role { font-size: 24rpx; color: rgba(255,255,255,.65); margin-top: 10rpx; letter-spacing: 2rpx; }
.pf { margin-top: 36rpx; }
.pf-foot { text-align: center; padding: 70rpx 0 50rpx; display: flex; flex-direction: column; }
.pf-cn { font-size: 26rpx; letter-spacing: 8rpx; color: #2B3FA8; }
.pf-en { font-size: 20rpx; letter-spacing: 3rpx; color: rgba(22,36,74,.35); margin-top: 8rpx; }

/* ── 信息弹层：每条独立一行 ── */
.mask { position: fixed; inset: 0; background: rgba(22,36,74,.42); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #FFFFFF; border-radius: 40rpx 40rpx 0 0; padding: 44rpx 40rpx 56rpx;
}
.sh-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.sh-t { font-size: 40rpx; font-weight: 800; letter-spacing: 3rpx; color: #16244A; }
.sh-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.5);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.sh-intro { font-size: 29rpx; color: rgba(22,36,74,.75); line-height: 1.85; letter-spacing: .5rpx;
  padding: 8rpx 0 32rpx; }

.sh-rows { padding: 4rpx 0 8rpx; }
.sh-row {
  display: flex; align-items: flex-start;
  padding: 28rpx 0; border-bottom: 2rpx solid #F0F3F9;
}
.sh-row:last-child { border-bottom: none; }
.sh-l { font-size: 25rpx; color: rgba(22,36,74,.45); letter-spacing: 2rpx; width: 150rpx; flex-shrink: 0; padding-top: 4rpx; }
.sh-v { flex: 1; font-size: 30rpx; font-weight: 700; color: #16244A; text-align: right; letter-spacing: .5rpx; }
.sh-v.wrap { line-height: 1.6; word-break: break-all; }
.sh-c { font-size: 20rpx; font-weight: 700; color: #2B3FA8; background: #EDF6FB;
  padding: 5rpx 16rpx; border-radius: 100rpx; margin-left: 16rpx; flex-shrink: 0; letter-spacing: 1rpx; }

.sh-tip { font-size: 22rpx; color: rgba(22,36,74,.4); text-align: center; margin: 24rpx 0 28rpx; letter-spacing: 1rpx; }
.sh-ok { margin-top: 8rpx; }
