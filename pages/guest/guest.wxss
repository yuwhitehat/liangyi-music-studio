
.card {
  margin: 32rpx 40rpx 0; padding: 40rpx;
  background: #FFFFFF; border: 6rpx solid #111111; border-radius: 32rpx;
  box-shadow: 12rpx 12rpx 0 var(--blue);
}
/* 三张卡各占一个原色：头部蓝、关于黄、联系粉 */
.card.c-yellow { box-shadow: 12rpx 12rpx 0 var(--yellow); }
.card.c-pink   { box-shadow: 12rpx 12rpx 0 var(--pink); }
.card-t { font-size: 34rpx; font-weight: 900; color: #111111; letter-spacing: 3rpx; }
.intro {
  margin-top: 24rpx; font-size: 28rpx; line-height: 1.95;
  color: rgba(17,17,17,.72); letter-spacing: .5rpx; white-space: pre-wrap;
}
.ph { margin-top: 22rpx; font-size: 26rpx; color: rgba(17,17,17,.4); letter-spacing: 1rpx; }

.row { display: flex; align-items: flex-start; padding: 26rpx 0; border-bottom: 2rpx solid rgba(17,17,17,.12); }
.row:last-child { border-bottom: none; }
.row-l { width: 150rpx; flex-shrink: 0; font-size: 25rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; padding-top: 4rpx; }
.row-v { flex: 1; font-size: 29rpx; font-weight: 700; color: #111111; text-align: right; word-break: break-all; }
.row-v.wrap { line-height: 1.6; }

.safe { height: 80rpx; }
