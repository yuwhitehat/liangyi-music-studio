
.tcard { display: flex; align-items: center; background: #FFFFFF;
  border: var(--bd) solid var(--ink); border-radius: 32rpx; padding: 30rpx;
  margin: 0 40rpx 24rpx; box-shadow: 10rpx 10rpx 0 var(--blue); }
.tcard:nth-child(even) { box-shadow: 10rpx 10rpx 0 var(--pink); }
.t-ava { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0;
  border: 4rpx solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 700; margin-right: 26rpx; }
.t-b { flex: 1; min-width: 0; }
.t-name { font-size: 32rpx; font-weight: 800; color: var(--ink); }
.t-name .tag { margin-left: 14rpx; vertical-align: middle; }
.t-phone { font-size: 24rpx; color: rgba(17,17,17,.5); margin-top: 8rpx; letter-spacing: 1rpx; }
.t-perms { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.t-perm { font-size: 20rpx; font-weight: 700; color: var(--ink); background: var(--sky-lt);
  border: 3rpx solid var(--ink); padding: 4rpx 16rpx; border-radius: 100rpx; letter-spacing: 1rpx; }
.t-go { font-size: 44rpx; color: rgba(17,17,17,.3); flex-shrink: 0; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(17,17,17,.45); z-index: 30; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 31; background: #FFFFFF;
  border-top: var(--bd) solid var(--ink); padding: 44rpx 40rpx 60rpx;
  max-height: 88vh; overflow-y: auto; }
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 36rpx; }
.sheet-t { font-size: 40rpx; font-weight: 900; letter-spacing: 3rpx; color: var(--ink); }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFFFFF;
  border: 4rpx solid var(--ink); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

/* 权限区 */
.perm-box { background: var(--sky-lt); border: 4rpx solid var(--ink); border-radius: 32rpx;
  padding: 28rpx 30rpx; margin-bottom: 40rpx; box-shadow: 10rpx 10rpx 0 rgba(17,17,17,.14); }
.perm-h { display: block; font-size: 22rpx; color: rgba(17,17,17,.5); letter-spacing: 3rpx; margin-bottom: 8rpx; }
.perm-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0;
  border-top: 3rpx solid rgba(17,17,17,.12); }
.perm-t { flex: 1; padding-right: 24rpx; }
.perm-n { display: block; font-size: 29rpx; font-weight: 700; color: var(--ink); }
.perm-d { display: block; font-size: 22rpx; color: rgba(17,17,17,.5); margin-top: 6rpx; line-height: 1.5; }
.perm-super { border-top: 3rpx dashed var(--ink); }
.perm-super .perm-n { color: var(--ink); background: var(--yellow);
  display: inline-block; padding: 2rpx 16rpx; border-radius: 100rpx; border: 3rpx solid var(--ink); }
.perm-note { font-size: 21rpx; color: rgba(17,17,17,.45); line-height: 1.6; padding-top: 14rpx;
  border-top: 3rpx solid rgba(17,17,17,.12); }

.del {
  text-align: center; margin-top: 32rpx; padding: 20rpx; font-size: 27rpx;
  color: #FFFFFF; background: #C0392B; border: 4rpx solid var(--ink);
  border-radius: 100rpx; font-weight: 700; letter-spacing: 2rpx;
  box-shadow: 8rpx 8rpx 0 rgba(17,17,17,.25);
}
.del:active, .del.tile-hover { transform: translate(6rpx,6rpx); box-shadow: 0 0 0 rgba(17,17,17,.25); }
