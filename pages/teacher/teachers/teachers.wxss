.nav { padding-bottom: 50rpx; }
.nav-plant { width: 150rpx; height: 195rpx; right: 40rpx; top: 70rpx; opacity: .22; }

.tcard { display: flex; align-items: center; background: #FFFFFF; border: 2rpx solid #E6ECF6;
  border-radius: 28rpx; padding: 30rpx; margin: 0 40rpx 20rpx; }
.t-ava { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 700; margin-right: 26rpx; }
.t-b { flex: 1; min-width: 0; }
.t-name { font-size: 32rpx; font-weight: 700; color: #16244A; }
.t-name .tag { margin-left: 14rpx; vertical-align: middle; }
.t-phone { font-size: 24rpx; color: rgba(22,36,74,.5); margin-top: 8rpx; letter-spacing: 1rpx; }
.t-perms { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.t-perm { font-size: 20rpx; font-weight: 700; color: #1E2E7A; background: #EDF6FB;
  padding: 4rpx 16rpx; border-radius: 100rpx; letter-spacing: 1rpx; }
.t-go { font-size: 44rpx; color: rgba(22,36,74,.28); flex-shrink: 0; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(22,36,74,.42); z-index: 30; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 31; background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0; padding: 44rpx 40rpx 60rpx; max-height: 88vh; overflow-y: auto; }
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 36rpx; }
.sheet-t { font-size: 40rpx; font-weight: 800; letter-spacing: 3rpx; color: #16244A; }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.5);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

/* 权限区 */
.perm-box { background: #F6F8FC; border: 2rpx solid #E6ECF6; border-radius: 28rpx;
  padding: 28rpx 30rpx; margin-bottom: 40rpx; }
.perm-h { display: block; font-size: 22rpx; color: rgba(22,36,74,.45); letter-spacing: 3rpx; margin-bottom: 8rpx; }
.perm-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0;
  border-top: 2rpx solid rgba(22,36,74,.07); }
.perm-t { flex: 1; padding-right: 24rpx; }
.perm-n { display: block; font-size: 29rpx; font-weight: 700; color: #16244A; }
.perm-d { display: block; font-size: 22rpx; color: rgba(22,36,74,.5); margin-top: 6rpx; line-height: 1.5; }
.perm-super { border-top: 2rpx dashed rgba(232,118,58,.4); }
.perm-super .perm-n { color: #E8763A; }
.perm-note { font-size: 21rpx; color: rgba(22,36,74,.4); line-height: 1.6; padding-top: 14rpx;
  border-top: 2rpx solid rgba(22,36,74,.07); }

.del { text-align: center; margin-top: 32rpx; padding: 20rpx; font-size: 27rpx;
  color: #E8763A; font-weight: 700; letter-spacing: 2rpx; }
