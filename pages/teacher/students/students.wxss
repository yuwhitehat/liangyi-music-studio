
.srch { display: flex; align-items: center; gap: 20rpx; padding: 32rpx 40rpx 8rpx; }
.srch .field-i { flex: 1; }
.add-btn {
  width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 50%;
  background: var(--pink); color: var(--ink); font-size: 52rpx; font-weight: 500;
  border: var(--bd) solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 10rpx 10rpx 0 rgba(17,17,17,.25);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s;
}
.add-btn:active, .add-btn.tile-hover { transform: translate(8rpx,8rpx); box-shadow: 0 0 0 rgba(17,17,17,.25); }

.st-ava {
  width: 92rpx; height: 92rpx; border-radius: 50%; flex-shrink: 0;
  border: 4rpx solid var(--ink);
  font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-right: 26rpx;
}
.st-go { font-size: 44rpx; color: rgba(17,17,17,.3); flex-shrink: 0; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(17,17,17,.45); z-index: 30; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 31; background: #FFFFFF;
  border-top: var(--bd) solid var(--ink); padding: 44rpx 40rpx 60rpx; }
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.sheet-t { font-size: 40rpx; font-weight: 900; letter-spacing: 3rpx; color: var(--ink); }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFFFFF;
  border: 4rpx solid var(--ink); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.form-body { max-height: 58vh; }

/* 分组 */
.grp { background: var(--sky-lt); border: 4rpx solid var(--ink); border-radius: 32rpx;
  padding: 28rpx 30rpx; margin-bottom: 36rpx;
  box-shadow: 10rpx 10rpx 0 rgba(17,17,17,.14); }
.grp-t { display: block; font-size: 26rpx; font-weight: 900; color: var(--ink); letter-spacing: 2rpx; }
.grp-d { display: block; font-size: 21rpx; color: rgba(17,17,17,.5); line-height: 1.6; margin: 8rpx 0 24rpx; }
.opt { font-size: 19rpx; font-weight: 700; color: var(--ink); background: var(--yellow);
  border: 3rpx solid var(--ink); padding: 3rpx 14rpx; border-radius: 100rpx;
  margin-left: 12rpx; vertical-align: middle; letter-spacing: 1rpx; }
.two { display: flex; gap: 20rpx; }
.sub { flex: 1; min-width: 0; }
.field-i.num { text-align: center; padding: 0 16rpx; }

/* 日期选择框 */
.dt {
  background: #FFFFFF; border: 5rpx solid var(--ink); border-radius: 28rpx;
  height: 112rpx; line-height: 102rpx; text-align: center;
  font-size: 27rpx; color: rgba(17,17,17,.4); box-sizing: border-box;
  box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.12);
}
.dt.has { color: var(--ink); font-weight: 700; font-size: 29rpx; }
.clr { text-align: right; font-size: 22rpx; color: var(--ink); background: var(--yellow);
  display: inline-block; float: right; padding: 6rpx 20rpx; border-radius: 100rpx;
  border: 3rpx solid var(--ink); font-weight: 700; margin-top: 18rpx; letter-spacing: 1rpx; }

.del {
  text-align: center; margin-top: 32rpx; padding: 20rpx; font-size: 27rpx;
  color: #FFFFFF; background: #C0392B; border: 4rpx solid var(--ink);
  border-radius: 100rpx; font-weight: 700; letter-spacing: 2rpx;
  box-shadow: 8rpx 8rpx 0 rgba(17,17,17,.25);
}
.del:active, .del.tile-hover { transform: translate(6rpx,6rpx); box-shadow: 0 0 0 rgba(17,17,17,.25); }

.item-over {
  display: inline-block; margin-top: 10rpx; padding: 3rpx 16rpx;
  border-radius: 100rpx; background: rgba(192,57,43,.1);
  border: 3rpx solid #C0392B;
  color: #C0392B; font-size: 21rpx; font-weight: 700; letter-spacing: .5rpx;
}
