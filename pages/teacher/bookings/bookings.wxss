/* ── 筛选行 ── */
.frow { display: flex; align-items: center; padding: 0 0 0 40rpx; }
.frow:first-of-type { padding-top: 32rpx; }
.fcap { font-size: 22rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; width: 56rpx; flex-shrink: 0; }
.chips { display: flex; gap: 16rpx; padding: 14rpx 0; overflow-x: auto; white-space: nowrap; flex: 1; }
.chips::-webkit-scrollbar { display: none; }
.pk-wrap { flex-shrink: 0; }
.pk-wrap .chip { display: inline-block; }

.sumbar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 8rpx 40rpx 26rpx; margin-top: -6rpx;
}
.sum-n { font-size: 34rpx; font-weight: 900; color: var(--ink); line-height: 1; }
.sum-t { font-size: 23rpx; color: rgba(17,17,17,.5); letter-spacing: 1rpx; flex: 1; }
.sum-x {
  font-size: 23rpx; color: var(--ink); font-weight: 700; letter-spacing: 1rpx;
  padding: 8rpx 22rpx; background: var(--yellow); border: 4rpx solid var(--ink);
  border-radius: 100rpx;
}

/* 约课卡片：白卡 + 黑边 + 错位硬影；左日期条用分隔线而非色块 */
.bk {
  display: flex; background: #FFFFFF; border: var(--bd) solid var(--ink);
  border-radius: 36rpx; margin: 0 40rpx 28rpx;
  box-shadow: 12rpx 12rpx 0 var(--blue);
}
.bk-l {
  width: 118rpx; flex-shrink: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; color: var(--ink);
  border-right: 4rpx solid var(--ink); background: var(--sky-lt);
  border-radius: 30rpx 0 0 30rpx;
}
.bk-d1 { font-size: 48rpx; font-weight: 900; line-height: 1; }
.bk-d2 { font-size: 22rpx; opacity: .6; margin-top: 10rpx; font-weight: 700; }
.bk-b { flex: 1; min-width: 0; padding: 28rpx 28rpx; }
.bk-t { font-size: 36rpx; font-weight: 800; color: var(--ink); letter-spacing: 2rpx; }
.bk-m { display: flex; align-items: baseline; gap: 14rpx; margin-top: 14rpx; flex-wrap: wrap; }
.bk-time { font-size: 32rpx; font-weight: 800; color: var(--ink); letter-spacing: .5rpx; }
.bk-dur {
  font-size: 20rpx; font-weight: 700; color: var(--ink);
  background: var(--pink); padding: 3rpx 14rpx; border-radius: 100rpx;
  border: 3rpx solid var(--ink);
}
.bk-date { font-size: 23rpx; color: rgba(17,17,17,.45); margin-left: auto; letter-spacing: 1rpx; }
.bk-s { font-size: 26rpx; color: rgba(17,17,17,.65); margin-top: 8rpx; font-weight: 600; }

/* 按钮行：flex-wrap + 等宽，彻底避免溢出卡片 */
.bk-a { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.ba-btn {
  flex: 1 1 30%; min-width: 132rpx;
  height: 68rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 100rpx; font-size: 25rpx; font-weight: 700; letter-spacing: 1rpx;
  background: #FFFFFF; color: var(--ink); border: 4rpx solid var(--ink);
  box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.18);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s;
}
.ba-btn:active, .ba-btn.tile-hover { transform: translate(4rpx,4rpx); box-shadow: 0 0 0 rgba(17,17,17,.18); }
.ba-main { background: var(--pink); color: var(--ink); box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.3); }

/* ── 指定学员弹层 ── */
.mask { position: fixed; inset: 0; background: rgba(17,17,17,.45); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #FFFFFF; border-top: var(--bd) solid var(--ink);
  padding: 44rpx 40rpx 40rpx; max-height: 80vh; display: flex; flex-direction: column;
}
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-t { font-size: 40rpx; font-weight: 900; letter-spacing: 3rpx; color: var(--ink); }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFFFFF;
  border: 4rpx solid var(--ink); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }
.pk-target { background: var(--sky); border: 4rpx solid var(--ink); border-radius: 20rpx;
  padding: 20rpx 28rpx; font-size: 26rpx; font-weight: 700; letter-spacing: 1rpx;
  margin-bottom: 24rpx; color: var(--ink); }
.pk-list { flex: 1; max-height: 48vh; margin-top: 12rpx; }
.pk-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 3rpx solid rgba(17,17,17,.12); }
.pk-ava { width: 76rpx; height: 76rpx; border-radius: 50%; border: 4rpx solid var(--ink); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; margin-right: 24rpx; }
.pk-b { flex: 1; min-width: 0; }
.pk-n { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.pk-s { font-size: 22rpx; color: rgba(17,17,17,.5); margin-top: 4rpx; }
.pk-box { width: 48rpx; height: 48rpx; border-radius: 14rpx; border: 4rpx solid var(--ink); flex-shrink: 0;
  background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #FFFFFF; }
.pk-box.on { background: var(--ink); }
.pk-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 24rpx; border-top: 4rpx solid var(--ink); }
.pk-cnt { font-size: 26rpx; color: rgba(17,17,17,.55); }

/* ── 取消课程 / 扣课时弹层 ── */
.cx-note {
  border: 4rpx solid var(--ink); border-radius: 20rpx; padding: 22rpx 26rpx;
  font-size: 25rpx; line-height: 1.6; background: var(--sky); color: var(--ink);
  box-shadow: 8rpx 8rpx 0 var(--yellow);
}
.cx-note.go { background: #EAF1FF; box-shadow: 8rpx 8rpx 0 var(--blue); }
.cx-lab { font-size: 24rpx; color: rgba(17,17,17,.55); letter-spacing: 1rpx; margin: 28rpx 0 16rpx; }
.cx-opt {
  display: flex; align-items: flex-start; gap: 18rpx;
  border: 4rpx solid var(--ink); border-radius: 20rpx; padding: 22rpx 24rpx;
  background: #FFFFFF; box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.12); margin-bottom: 16rpx;
  transition: transform .11s, box-shadow .11s, background .11s;
}
.cx-opt.on { background: #FFEFF6; box-shadow: 6rpx 6rpx 0 var(--pink); transform: translate(-2rpx,-2rpx); }
.cx-radio {
  width: 36rpx; height: 36rpx; flex-shrink: 0; margin-top: 4rpx;
  border: 4rpx solid var(--ink); border-radius: 50%; background: #FFFFFF; position: relative;
}
.cx-opt.on .cx-radio::after {
  content: ""; position: absolute; left: 6rpx; top: 6rpx; right: 6rpx; bottom: 6rpx;
  border-radius: 50%; background: var(--pink);
}
.cx-ob { flex: 1; min-width: 0; }
.cx-ot { font-size: 29rpx; font-weight: 700; color: var(--ink); }
.cx-od { font-size: 22rpx; color: rgba(17,17,17,.55); margin-top: 6rpx; line-height: 1.5; }
.cx-list { max-height: 30vh; }
.cx-stu {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  border: 3rpx dashed rgba(17,17,17,.45); border-radius: 18rpx; padding: 18rpx 22rpx; margin-bottom: 12rpx;
}
.cx-nm { font-size: 27rpx; font-weight: 700; color: var(--ink); flex-shrink: 0; }
.cx-num { font-size: 23rpx; color: rgba(17,17,17,.55); text-align: right; }
.cx-num.nb { color: var(--blue); font-weight: 700; }
.cx-to { display: none; color: var(--pink-d); font-weight: 800; }
.cx-to.on { display: inline; }
.cx-none { font-size: 24rpx; color: rgba(17,17,17,.5); padding: 18rpx 0; }
/* 弹层底部两个按钮等宽平分，避免文字被挤到换行 */
.cx-foot { gap: 20rpx; }
.cx-foot .ba-btn { flex: 1 1 0; min-width: 0; padding: 0; }
.ba-charge { background: var(--yellow); color: var(--ink); box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.3); }

.occ {
  display: inline-block; margin-left: 12rpx; padding: 2rpx 14rpx;
  border-radius: 100rpx; background: var(--sky-lt);
  border: 3rpx solid var(--ink); color: var(--ink);
  font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
}

/* ── 空状态增强 ── */
.empty-s { font-size: 23rpx; color: rgba(17,17,17,.4); margin-top: 10rpx; letter-spacing: 1rpx; }
.empty-a {
  margin-top: 28rpx; padding: 14rpx 40rpx;
  background: #FFFFFF; border: 4rpx solid var(--ink); border-radius: 100rpx;
  box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.2);
  font-size: 25rpx; font-weight: 700; color: var(--ink); letter-spacing: 2rpx;
}
