.nav { padding-bottom: 50rpx; }
.nav-plant { width: 150rpx; height: 195rpx; right: 40rpx; top: 70rpx; opacity: .22; }
.form { padding: 48rpx 40rpx 80rpx; }
.field { position: relative; margin-bottom: 36rpx; }
/* <textarea> 是原生组件，padding 常不生效 —— 边框与内边距交给外层 .ta-box */
.ta-box {
  background: #FFFFFF; border: 2rpx solid #E6ECF6; border-radius: 28rpx;
  padding: 26rpx 32rpx; height: 220rpx; box-sizing: border-box;
}
.ta-box-s { height: 160rpx; }
.field-ta {
  width: 100%; height: 100%; padding: 0; margin: 0;
  font-size: 30rpx; color: #16244A; line-height: 1.6;
  background: transparent; box-sizing: border-box;
}
.cnt { position: absolute; right: 24rpx; bottom: -32rpx; font-size: 20rpx; color: rgba(22,36,74,.35); }
.tip { font-size: 23rpx; color: rgba(22,36,74,.45); margin: 8rpx 0 36rpx; line-height: 1.7; }
