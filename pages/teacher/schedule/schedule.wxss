.nav { padding-bottom: 50rpx; }

/* 日期 */
.hscroll { width: 100%; white-space: nowrap; }
.hrow { display: inline-flex; gap: 20rpx; padding: 0 40rpx 8rpx; }
.dcard { flex-shrink: 0; width: 132rpx; background: #FFFFFF; border: 2rpx solid #E6ECF6;
  border-radius: 28rpx; padding: 26rpx 0; text-align: center; }
.dcard.on { background: #2B3FA8; border-color: #2B3FA8; }
.dcard-w { font-size: 21rpx; color: rgba(22,36,74,.5); }
.dcard.on .dcard-w { color: rgba(255,255,255,.75); }
.dcard-d { font-size: 48rpx; font-weight: 800; color: #16244A; line-height: 1.3; }
.dcard.on .dcard-d { color: #FFFFFF; }
.dcard-m { font-size: 20rpx; color: rgba(22,36,74,.35); }
.dcard.on .dcard-m { color: rgba(255,255,255,.55); }

/* 课程类型：四门，每门带图标 chip + 默认时长 */
.cgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; padding: 0 40rpx; }
.ct { background: #FFFFFF; border: 2rpx solid #E6ECF6; border-radius: 28rpx; padding: 24rpx 6rpx; text-align: center; }
.ct.on { background: #2B3FA8; border-color: #2B3FA8; }
.ct-chip { display: block; width: 76rpx; height: 76rpx; margin: 0 auto 12rpx;
  border-radius: 22rpx; background-color: #EDF6FB;
  background-repeat: no-repeat; background-position: center; background-size: 50rpx 50rpx; }
.ct.on .ct-chip { background-color: #FFFFFF; }
.ct-n { font-size: 26rpx; color: #16244A; margin-top: 10rpx; font-weight: 700; }
.ct.on .ct-n { color: #FFFFFF; }
.ct-d { font-size: 20rpx; color: rgba(22,36,74,.4); margin-top: 4rpx; }
.ct.on .ct-d { color: rgba(255,255,255,.6); }

/* 自由时间面板 */
.tpanel { margin: 0 40rpx; background: #FFFFFF; border: 2rpx solid #E6ECF6; border-radius: 32rpx; padding: 36rpx; }
.tp-row { display: flex; align-items: center; }
.tp-cell { flex: 1; }
.tp-l { display: block; font-size: 22rpx; color: rgba(22,36,74,.45); letter-spacing: 2rpx; margin-bottom: 12rpx; }
.tp-val {
  background: #EDF6FB; border-radius: 24rpx; padding: 24rpx 0; text-align: center;
  font-size: 44rpx; font-weight: 800; color: #1E2E7A; letter-spacing: 2rpx;
}
.tp-dash { font-size: 36rpx; color: rgba(22,36,74,.3); padding: 44rpx 20rpx 0; }
.tp-dur { width: 140rpx; text-align: center; padding-left: 20rpx; }
.tp-num { display: block; font-size: 52rpx; font-weight: 800; color: #E8763A; line-height: 1; }
.tp-unit { display: block; font-size: 20rpx; color: rgba(22,36,74,.45); margin-top: 8rpx; letter-spacing: 2rpx; }

/* 快捷时长 */
.qp { margin-top: 36rpx; }
.qp-l { font-size: 22rpx; color: rgba(22,36,74,.45); letter-spacing: 2rpx; }
.qp-chips { display: flex; gap: 18rpx; margin-top: 18rpx; }
.qp-c { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 100rpx;
  font-size: 26rpx; font-weight: 700; background: #F6F8FC; color: rgba(22,36,74,.6);
  border: 2rpx solid #E6ECF6; }
.qp-c.on { background: #E8763A; color: #FFFFFF; border-color: #E8763A; }

.btn-add { margin-top: 36rpx; height: 96rpx; font-size: 30rpx; letter-spacing: 3rpx; }

/* 已添加时段 */
.srow { display: flex; align-items: center; background: #FFFFFF; border: 2rpx solid #E6ECF6;
  border-radius: 28rpx; padding: 26rpx 30rpx; margin: 0 40rpx 20rpx; }
.srow-chip { width: 76rpx; height: 76rpx; border-radius: 22rpx; background-color: #EDF6FB; flex-shrink: 0;
  background-repeat: no-repeat; background-position: center; background-size: 50rpx 50rpx; margin-right: 26rpx; }
.srow-b { flex: 1; min-width: 0; }
.srow-t { font-size: 32rpx; font-weight: 800; color: #16244A; letter-spacing: 1rpx; }
.srow-s { font-size: 24rpx; color: rgba(22,36,74,.5); margin-top: 6rpx; }
.srow-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.45);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0; }

/* ── 日期卡：当天已有课时的提示 ── */
.dcard.busy .dcard-m { color: #E8763A; font-weight: 700; }
.dcard.on.busy .dcard-m { color: #FFD9BF; }

/* ── 已有预约开关 ── */
.bk-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 36rpx; padding: 26rpx 30rpx;
  background: #F6F8FC; border: 2rpx solid #E6ECF6; border-radius: 24rpx;
}
.bk-l { flex: 1; padding-right: 20rpx; }
.bk-t { display: block; font-size: 29rpx; font-weight: 700; color: #16244A; letter-spacing: 1rpx; }
.bk-s { display: block; font-size: 22rpx; color: rgba(22,36,74,.5); margin-top: 6rpx; line-height: 1.6; }

.bk-stu { margin-top: 24rpx; }
.bk-stu-h {
  display: flex; align-items: center; justify-content: space-between;
  background: #EDF6FB; border-radius: 24rpx; padding: 26rpx 30rpx;
}
.bk-stu-l { font-size: 28rpx; font-weight: 700; color: #1E2E7A; }
.bk-stu-v { font-size: 27rpx; color: #2B3FA8; max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bk-tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.bk-tag {
  display: flex; align-items: center; gap: 12rpx;
  background: #2B3FA8; color: #FFFFFF; border-radius: 100rpx; padding: 10rpx 22rpx; font-size: 25rpx;
}
.bk-tag-x { font-size: 22rpx; opacity: .75; padding: 0 4rpx; }

/* ── 待排列表：已约/待约小标 ── */
.srow-tag {
  display: inline-block; margin-left: 14rpx; padding: 4rpx 16rpx; border-radius: 100rpx;
  font-size: 20rpx; font-weight: 700; background: #D9EAF5; color: #1E2E7A; vertical-align: middle;
}
.srow-tag.on { background: #E8763A; color: #FFFFFF; }

/* ── 学员选择弹层 ── */
.mask { position: fixed; inset: 0; background: rgba(22,36,74,.42); z-index: 30; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: #FFFFFF; border-radius: 40rpx 40rpx 0 0; padding: 44rpx 40rpx 40rpx;
  max-height: 80vh; display: flex; flex-direction: column;
}
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; }
.sheet-t { font-size: 40rpx; font-weight: 800; letter-spacing: 3rpx; color: #16244A; }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.5);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.pk-list { flex: 1; max-height: 52vh; margin-top: 24rpx; }
.pk-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #F0F3F9; }
.pk-ava { width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; margin-right: 24rpx; }
.pk-b { flex: 1; min-width: 0; }
.pk-n { font-size: 30rpx; font-weight: 700; color: #16244A; }
.pk-s { font-size: 22rpx; color: rgba(22,36,74,.5); margin-top: 4rpx; }
.pk-box { width: 48rpx; height: 48rpx; border-radius: 14rpx; border: 3rpx solid #C9D6EA; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #FFFFFF; }
.pk-box.on { background: #2B3FA8; border-color: #2B3FA8; }
.pk-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 28rpx; border-top: 2rpx solid #F0F3F9; }
.pk-cnt { font-size: 26rpx; color: rgba(22,36,74,.55); letter-spacing: 1rpx; }

/* ── 固定课提示 ── */
.rp-hint {
  margin-top: 18rpx; padding: 18rpx 24rpx;
  background: #EDF6FB; border-radius: 18rpx;
  font-size: 23rpx; color: #1E2E7A; letter-spacing: 1rpx; line-height: 1.6;
}
.srow-rp {
  display: inline-block; margin-top: 10rpx; align-self: flex-start;
  padding: 4rpx 16rpx; border-radius: 100rpx;
  background: #2B3FA8; color: #FFFFFF; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx;
}

/* ── 冲突清单 ── */
.cf-list { max-height: 52vh; overflow-y: auto; margin-bottom: 36rpx; }
.cf-item { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx 0;
  border-bottom: 2rpx solid #F0F3F9; }
.cf-item:last-child { border-bottom: none; }
.cf-no { width: 40rpx; height: 40rpx; flex-shrink: 0; border-radius: 50%;
  background: #E8763A; color: #FFFFFF; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-top: 2rpx; }
.cf-txt { flex: 1; font-size: 26rpx; color: #16244A; line-height: 1.6; letter-spacing: .5rpx; word-break: break-all; }
