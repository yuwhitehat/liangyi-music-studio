
.crow { display: flex; align-items: center; background: #FFFFFF;
  border: var(--bd) solid var(--ink); border-radius: 32rpx; padding: 26rpx 30rpx;
  margin: 0 40rpx 24rpx; box-shadow: 10rpx 10rpx 0 var(--yellow); }
.crow-chip { width: 84rpx; height: 84rpx; border-radius: 24rpx; background-color: var(--sky);
  border: 4rpx solid var(--ink); flex-shrink: 0;
  background-repeat: no-repeat; background-position: center; background-size: 54rpx 54rpx; margin-right: 26rpx; }
.crow-b { flex: 1; min-width: 0; }
.crow-n { font-size: 34rpx; font-weight: 800; color: var(--ink); letter-spacing: 2rpx; }
.crow-d { font-size: 23rpx; color: rgba(17,17,17,.5); margin-top: 6rpx; }
.crow-a { font-size: 25rpx; color: var(--ink); font-weight: 700; padding: 10rpx 22rpx;
  background: #FFFFFF; border: 4rpx solid var(--ink); border-radius: 100rpx;
  margin-right: 14rpx; flex-shrink: 0; }
.crow-a:active { background: var(--pink); }
.crow-x { width: 56rpx; height: 56rpx; border-radius: 50%; background: #FFFFFF;
  border: 4rpx solid var(--ink); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0; }

.acts { padding: 24rpx 40rpx 0; }
.act-reset { text-align: center; margin-top: 28rpx; font-size: 25rpx; color: rgba(17,17,17,.45); letter-spacing: 2rpx; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(17,17,17,.45); z-index: 20; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 21;
  background: #FFFFFF; border-top: var(--bd) solid var(--ink); padding: 44rpx 40rpx 60rpx;
  max-height: 84vh; overflow-y: auto;
}
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 44rpx; }
.sheet-t { font-size: 40rpx; font-weight: 900; letter-spacing: 3rpx; color: var(--ink); }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #FFFFFF;
  border: 4rpx solid var(--ink); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

/* 时长 */
.dur-chips { display: flex; gap: 16rpx; align-items: center; }
.dur-c { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 100rpx; font-size: 27rpx;
  font-weight: 700; background: #FFFFFF; color: var(--ink);
  border: 4rpx solid var(--ink); box-shadow: 5rpx 5rpx 0 rgba(17,17,17,.15); }
.dur-c.on { background: var(--ink); color: #FFFFFF; box-shadow: 5rpx 5rpx 0 var(--pink); }
.dur-in { width: 150rpx; flex-shrink: 0; background: var(--sky-lt); border: 4rpx solid var(--ink);
  border-radius: 100rpx; padding: 20rpx 0; text-align: center; font-size: 25rpx; color: var(--ink); font-weight: 700; }

/* 图标选择器 */
.igrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18rpx; }
.icell { background: #FFFFFF; border: 4rpx solid rgba(17,17,17,.25); border-radius: 24rpx; padding: 18rpx 4rpx 14rpx; text-align: center; }
.icell.on { background: var(--sky); border: 4rpx solid var(--ink); box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.2); }
.icell-chip { width: 62rpx; height: 62rpx; margin: 0 auto; border-radius: 18rpx; background-color: #FFFFFF;
  background-repeat: no-repeat; background-position: center; background-size: 44rpx 44rpx; }
.icell-l { display: block; font-size: 20rpx; color: rgba(17,17,17,.55); margin-top: 8rpx; }
.icell.on .icell-l { color: var(--ink); font-weight: 700; }
