.nav { padding-bottom: 50rpx; }

.crow { display: flex; align-items: center; background: #FFFFFF; border: 2rpx solid #E6ECF6;
  border-radius: 28rpx; padding: 26rpx 30rpx; margin: 0 40rpx 20rpx; }
.crow-chip { width: 84rpx; height: 84rpx; border-radius: 24rpx; background-color: #EDF6FB; flex-shrink: 0;
  background-repeat: no-repeat; background-position: center; background-size: 54rpx 54rpx; margin-right: 26rpx; }
.crow-b { flex: 1; min-width: 0; }
.crow-n { font-size: 34rpx; font-weight: 700; color: #16244A; letter-spacing: 2rpx; }
.crow-d { font-size: 23rpx; color: rgba(22,36,74,.5); margin-top: 6rpx; }
.crow-a { font-size: 25rpx; color: #2B3FA8; font-weight: 700; padding: 10rpx 22rpx;
  background: #EDF6FB; border-radius: 100rpx; margin-right: 14rpx; flex-shrink: 0; }
.crow-x { width: 56rpx; height: 56rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.4);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0; }

.acts { padding: 24rpx 40rpx 0; }
.act-reset { text-align: center; margin-top: 28rpx; font-size: 25rpx; color: rgba(22,36,74,.4); letter-spacing: 2rpx; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(22,36,74,.42); z-index: 20; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 21;
  background: #FFFFFF; border-radius: 40rpx 40rpx 0 0; padding: 44rpx 40rpx 60rpx;
  max-height: 84vh; overflow-y: auto;
}
.sheet-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 44rpx; }
.sheet-t { font-size: 40rpx; font-weight: 800; letter-spacing: 3rpx; color: #16244A; }
.sheet-x { width: 64rpx; height: 64rpx; border-radius: 50%; background: #F6F8FC; color: rgba(22,36,74,.5);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

/* 时长 */
.dur-chips { display: flex; gap: 16rpx; align-items: center; }
.dur-c { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 100rpx; font-size: 27rpx;
  font-weight: 700; background: #F6F8FC; color: rgba(22,36,74,.6); border: 2rpx solid #E6ECF6; }
.dur-c.on { background: #2B3FA8; color: #FFFFFF; border-color: #2B3FA8; }
.dur-in { width: 150rpx; flex-shrink: 0; background: #F6F8FC; border: 2rpx solid #E6ECF6;
  border-radius: 100rpx; padding: 20rpx 0; text-align: center; font-size: 25rpx; color: #16244A; }

/* 图标选择器 */
.igrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18rpx; }
.icell { background: #F6F8FC; border: 3rpx solid transparent; border-radius: 24rpx; padding: 18rpx 4rpx 14rpx; text-align: center; }
.icell.on { background: #EDF6FB; border-color: #2B3FA8; }
.icell-chip { width: 62rpx; height: 62rpx; margin: 0 auto; border-radius: 18rpx; background-color: #FFFFFF;
  background-repeat: no-repeat; background-position: center; background-size: 44rpx 44rpx; }
.icell-l { display: block; font-size: 20rpx; color: rgba(22,36,74,.6); margin-top: 8rpx; }
.icell.on .icell-l { color: #2B3FA8; font-weight: 700; }
