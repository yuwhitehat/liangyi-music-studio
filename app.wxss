/* ══════════════════════════════════════════════════════════
   贴纸入口（首页 / 老师端 / 学员端共用）
   白卡 + 黑描边 + 错位硬彩影；按下时影子压扁 = 贴纸回弹手感
   ══════════════════════════════════════════════════════════ */
.tiles {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 32rpx; padding: 44rpx 40rpx 12rpx;
}
.tile {
  position: relative; height: 268rpx; border-radius: 40rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: var(--white); color: var(--ink);
  border: var(--bd) solid var(--ink);
  box-shadow: 16rpx 16rpx 0 var(--blue);
  transform: translate(0, 0);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s cubic-bezier(.3,.7,.4,1);
}
.tile-hover, .tile:active { transform: translate(8rpx, 8rpx); box-shadow: 4rpx 4rpx 0 var(--blue); }
.tile.b-cobalt { box-shadow: 16rpx 16rpx 0 var(--blue); }
.tile.b-cobalt.tile-hover, .tile.b-cobalt:active { box-shadow: 4rpx 4rpx 0 var(--blue); }
.tile.b-terra  { box-shadow: 16rpx 16rpx 0 var(--pink); }
.tile.b-terra.tile-hover, .tile.b-terra:active { box-shadow: 4rpx 4rpx 0 var(--pink); }
.tile.b-light  { box-shadow: 16rpx 16rpx 0 var(--yellow); }
.tile.b-light.tile-hover, .tile.b-light:active { box-shadow: 4rpx 4rpx 0 var(--yellow); }
.tile.b-navy   { box-shadow: 16rpx 16rpx 0 var(--ink); }
.tile.b-navy.tile-hover, .tile.b-navy:active { box-shadow: 4rpx 4rpx 0 var(--ink); }
.tile-t { font-size: 44rpx; font-weight: 800; letter-spacing: 6rpx; position: relative; z-index: 2; color: var(--ink); }
.tile-a { position: relative; width: 96rpx; height: 82rpx; margin-top: 26rpx; z-index: 2; }
