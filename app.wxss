/* ══════════════════════════════════════════════════════════
   实体色块入口（首页 / 老师端 / 学员端共用）
   只有标题 + 卡通箭头，硬阴影 + 按下位移 = 按实体按钮的手感
   ══════════════════════════════════════════════════════════ */
.tiles {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 32rpx; padding: 44rpx 40rpx 12rpx;
}
.tile {
  position: relative; height: 268rpx; border-radius: 40rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  box-shadow: 0 16rpx 0 rgba(0,0,0,.22);
  transform: translateY(0);
  transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s cubic-bezier(.3,.7,.4,1);
}
.tile::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; height: 42rpx;
  border-radius: 40rpx 40rpx 60% 60%;
  background: rgba(255,255,255,.14); pointer-events: none;
}
.tile-hover, .tile:active { transform: translateY(16rpx); box-shadow: 0 0 0 rgba(0,0,0,.22); }
.tile.b-cobalt { background: var(--cobalt); color: var(--white); }
.tile.b-terra  { background: var(--terra);  color: var(--white); }
.tile.b-light  { background: var(--sky);    color: var(--cobalt-d);
                 box-shadow: 0 16rpx 0 rgba(30,46,122,.18); }
.tile.b-light::before { background: rgba(30,46,122,.06); }
.tile.b-light.tile-hover, .tile.b-light:active { box-shadow: 0 0 0 rgba(30,46,122,.18); }
.tile-t { font-size: 44rpx; font-weight: 700; letter-spacing: 6rpx; position: relative; z-index: 2; }
.tile-a { position: relative; width: 96rpx; height: 82rpx; margin-top: 26rpx; z-index: 2; }
