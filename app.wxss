/* ============================================
 * 两仪音乐工作室 · 设计系统 v5.0 贴纸手账风
 * 白卡 + 粗黑描边 + 错位硬彩影 · 颜色只当影子与胶囊
 * 方格纸底 · 多巴胺三色（粉/黄/蓝）
 * ============================================ */

page {
  --pink:    #FF5FA2;   /* 多巴胺粉 · 老师/主操作 */
  --pink-d:  #E93E83;   /* 粉加深（硬影） */
  --yellow:  #FFD23F;   /* 多巴胺黄 · 次级/提示 */
  --yellow-d:#E8B700;   /* 黄加深（硬影） */
  --blue:    #4D8DFF;   /* 多巴胺蓝 · 学员/进行中 */
  --blue-d:  #2E66D9;   /* 蓝加深（硬影） */

  /* 旧令牌别名：仅用于兼容过渡，改完页面后移除 */
  --cobalt:   #111111;
  --cobalt-d: #111111;
  --white:    #FFFFFF;
  --paper:    #F6F4EE;   /* 方格纸底 */
  --line:     #111111;   /* 全站统一粗黑描边 */
  --sky:      #FFF3C4;   /* 黄系浅底（小面积） */
  --sky-lt:   #FFF8DC;
  --terra:    #FF5FA2;
  --navy:     #111111;   /* 正文 */
  --tan:      #C98A4B;   /* 约克夏金棕 */
  --ink:      #111111;
  --grid:     rgba(43,63,168,.11);   /* 方格纸线色 */

  --bd: 6rpx;            /* 描边宽度 */
  --sh: 12rpx;           /* 错位硬影偏移 */

  --r-lg: 36rpx;
  --r-md: 28rpx;
  --r-sm: 20rpx;

  background: var(--paper);
  background-image: linear-gradient(var(--grid) 2rpx, transparent 2rpx),
                    linear-gradient(90deg, var(--grid) 2rpx, transparent 2rpx);
  background-size: 44rpx 44rpx;
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: .5rpx;
}

/* ============ 基础 ============ */
/* padding-top 不为美观：阻止头部卡的 margin-top 穿透 .page 折叠掉 */
.page { min-height: 100vh; background: transparent; padding-top: 2rpx; }
.pad { padding: 0 40rpx; }

/* ============ 色块：白卡 + 黑描边 + 错位硬彩影 ============ */
.blk {
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 40rpx;
  background: var(--white);
  color: var(--ink);
  border: var(--bd) solid var(--ink);
  box-shadow: var(--sh) var(--sh) 0 var(--blue);
  transition: transform .14s cubic-bezier(.3,.7,.4,1), box-shadow .14s cubic-bezier(.3,.7,.4,1);
}
.blk:active { transform: translate(6rpx, 6rpx); box-shadow: 4rpx 4rpx 0 var(--blue); }

/* 白卡为面 · 颜色只当影子 */
.b-cobalt { background: var(--white); color: var(--ink); box-shadow: var(--sh) var(--sh) 0 var(--blue); }
.b-terra  { background: var(--white); color: var(--ink); box-shadow: var(--sh) var(--sh) 0 var(--pink); }
.b-white  { background: var(--white); color: var(--ink); }
.b-sky    { background: var(--white); color: var(--ink); }
.b-navy   { background: var(--white); color: var(--ink); box-shadow: var(--sh) var(--sh) 0 var(--ink); }
.b-light  { background: var(--white); color: var(--ink); box-shadow: var(--sh) var(--sh) 0 var(--yellow); }
.b-light .hint { color: rgba(17,17,17,.55); opacity: 1; }
.b-terra:active, .blk-pink:active { box-shadow: 4rpx 4rpx 0 var(--pink); }
.b-cobalt:active { box-shadow: 4rpx 4rpx 0 var(--blue); }
.b-navy:active   { box-shadow: 4rpx 4rpx 0 var(--ink); }
.b-light:active  { box-shadow: 4rpx 4rpx 0 var(--yellow); }

/* ============ Bento ============ */
.bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 0 40rpx;
}
.sp2 { grid-column: span 2; }
.h-xl { min-height: 400rpx; }
.h-lg { min-height: 320rpx; }
.h-md { min-height: 220rpx; }
.h-sm { min-height: 160rpx; }

/* ============ 插画 ============ */
.ill {
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  position: absolute;
  pointer-events: none;
}
.ico {
  position: absolute;
  top: 40rpx; left: 40rpx;
  width: 108rpx; height: 108rpx;
  border-radius: 50%;
  border: 4rpx solid var(--ink);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 62rpx 62rpx;
  z-index: 2;
}
.ico-on-dark  { background-color: #FFE1EE; }
.ico-on-light { background-color: var(--sky); }

/* ============ 文字 ============ */
.lbl { font-size: 44rpx; font-weight: 800; letter-spacing: 4rpx; line-height: 1.25; position: relative; z-index: 2; color: var(--ink); }
.lbl-xl { font-size: 60rpx; letter-spacing: 6rpx; }
.lbl-sm { font-size: 34rpx; letter-spacing: 2rpx; }
.hint { font-size: 24rpx; opacity: .62; margin-top: 8rpx; letter-spacing: 2rpx; position: relative; z-index: 2; }
.b-white .hint, .b-sky .hint { opacity: 1; color: rgba(17,17,17,.55); }
.num { font-size: 96rpx; font-weight: 900; line-height: 1; letter-spacing: -2rpx; position: relative; z-index: 2; color: var(--ink); }

/* ============ 顶部：方格纸上的贴纸卡 ============ */
.top {
  position: relative;
  margin: 120rpx 40rpx 28rpx;
  padding: 32rpx 40rpx 36rpx;
  overflow: hidden;
  background: var(--white);
  border: var(--bd) solid var(--ink);
  border-radius: 44rpx;
  box-shadow: 16rpx 16rpx 0 var(--blue);
}
.top-h1 { font-size: 64rpx; font-weight: 900; letter-spacing: 4rpx; line-height: 1.2; color: var(--ink); position: relative; z-index: 2; }
.top-sub { font-size: 26rpx; margin-top: 14rpx; letter-spacing: 3rpx; color: rgba(17,17,17,.55); position: relative; z-index: 2; }
.top-ava {
  position: absolute; right: 40rpx; bottom: 48rpx;
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--white);
  border: 5rpx solid var(--ink);
  box-shadow: 6rpx 6rpx 0 var(--pink);
  display: flex; align-items: center; justify-content: center;
  z-index: 3;
}
.ava-ico { position: static; width: 52rpx; height: 52rpx; background-size: contain; }

/* 头部卡影子色：沿用进入该页那颗按钮的影子色（.top / .nav 通用） */
.top.hd-blue,   .nav.hd-blue   { box-shadow: 16rpx 16rpx 0 var(--blue); }
.top.hd-yellow, .nav.hd-yellow { box-shadow: 16rpx 16rpx 0 var(--yellow); }
.top.hd-pink,   .nav.hd-pink   { box-shadow: 16rpx 16rpx 0 var(--pink); }

/* 首页头部卡即「我的」入口，按下时沿影子方向压扁 */
.top { transition: transform .11s cubic-bezier(.3,.7,.4,1), box-shadow .11s cubic-bezier(.3,.7,.4,1); }
.top-hover { transform: translate(8rpx, 8rpx); }
.top.hd-blue.top-hover   { box-shadow: 4rpx 4rpx 0 var(--blue); }
.top.hd-yellow.top-hover { box-shadow: 4rpx 4rpx 0 var(--yellow); }
.top.hd-pink.top-hover   { box-shadow: 4rpx 4rpx 0 var(--pink); }

/* 头部卡右下角的约克夏：低透明度，贴着卡的下描边 */
.hd-dog { width: 190rpx; height: 98rpx; right: 18rpx; bottom: 0; opacity: .45; z-index: 1; }

/* ============ 导航 ============ */
.nav {
  position: relative;
  margin: 120rpx 40rpx 28rpx;
  padding: 32rpx 40rpx 108rpx;
  overflow: hidden;
  background: var(--white);
  border: var(--bd) solid var(--ink);
  border-radius: 44rpx;
  box-shadow: 16rpx 16rpx 0 var(--blue);
}
.nav-back {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: var(--white); color: var(--ink);
  border: 5rpx solid var(--ink);
  box-shadow: 5rpx 5rpx 0 var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; line-height: 1; position: relative; z-index: 3;
}
.nav-back::after { content: '‹'; }
.nav-h1 { font-size: 56rpx; font-weight: 900; letter-spacing: 6rpx; margin-top: 40rpx; color: var(--ink); position: relative; z-index: 2; }
.nav-sub { font-size: 24rpx; margin-top: 10rpx; letter-spacing: 3rpx; color: rgba(17,17,17,.55); position: relative; z-index: 2; }

/* ============ 分区 ============ */
.sec { padding: 56rpx 40rpx 24rpx; display: flex; align-items: baseline; gap: 16rpx; }
.sec-t { font-size: 34rpx; font-weight: 800; letter-spacing: 3rpx; color: var(--ink); }
.sec-n { font-size: 24rpx; color: var(--pink); font-weight: 800; }

/* ============ 乐器线条图标 chip ============ */
.item-chip {
  width: 96rpx; height: 96rpx; flex-shrink: 0;
  border-radius: 28rpx;
  border: 5rpx solid var(--ink);
  background-color: var(--sky);
  background-repeat: no-repeat; background-position: center;
  background-size: 62rpx 62rpx;
  margin-right: 26rpx;
}
.ic {
  background-repeat: no-repeat; background-position: center; background-size: contain;
}

/* ============ 列表卡 ============ */
.item {
  display: flex; align-items: center;
  background: var(--white);
  border: var(--bd) solid var(--ink);
  border-radius: var(--r-md);
  box-shadow: 10rpx 10rpx 0 var(--blue);
  padding: 32rpx;
  margin: 0 40rpx 28rpx;
}
.item-dot {
  width: 88rpx; height: 88rpx; flex-shrink: 0;
  border-radius: 28rpx;
  border: 5rpx solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; font-weight: 800;
  margin-right: 26rpx;
}
.item-b { flex: 1; min-width: 0; }
.item-t { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.item-s { font-size: 24rpx; color: rgba(17,17,17,.55); margin-top: 6rpx; }

/* ============ 标签（胶囊 · 黑描边） ============ */
.tag {
  display: inline-block; padding: 6rpx 22rpx; border-radius: 100rpx;
  font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; flex-shrink: 0;
  border: 4rpx solid var(--ink);
}
.t-cobalt { background: var(--pink);   color: var(--ink); }
.t-sky    { background: var(--sky);    color: var(--ink); }
.t-terra  { background: var(--blue);   color: #FFFFFF; }
.t-mute   { background: #FFFFFF; color: rgba(17,17,17,.5); border-color: rgba(17,17,17,.25); }
/* 已取消但扣了课时：实心黄，和淡黄的「待约」区分开 */
.t-charge { background: var(--yellow);  color: var(--ink); }

/* ============ 报名标记（课时按门记，选学员时这两类要当场看见） ============ */
.pk-warn, .pk-nb {
  font-size: 19rpx; font-weight: 800; border-radius: 100rpx; padding: 2rpx 14rpx;
  margin-left: 12rpx; vertical-align: middle; letter-spacing: 1rpx;
}
.pk-warn { color: #C0392B; border: 3rpx solid #C0392B; background: rgba(192,57,43,.08); }
.pk-nb { color: var(--blue); border: 3rpx solid var(--blue); }

/* 只提示、不拦：老师看完自己决定要不要排 */
.pick-warn {
  background: #FFE9F1; border: 4rpx solid var(--ink); border-radius: 20rpx;
  padding: 20rpx 24rpx; margin-top: 20rpx; box-shadow: 8rpx 8rpx 0 rgba(17,17,17,.14);
}
.pw-t { font-size: 25rpx; font-weight: 900; color: var(--ink); letter-spacing: 1rpx; }
.pw-l { font-size: 22rpx; color: var(--ink); line-height: 1.7; margin-top: 6rpx; }
.pw-d { font-size: 21rpx; color: rgba(17,17,17,.55); line-height: 1.6; margin-top: 10rpx; }

/* ============ 筛选 ============ */
.chips { display: flex; gap: 18rpx; padding: 8rpx 40rpx 36rpx; overflow-x: auto; white-space: nowrap; }
.chip {
  flex-shrink: 0; padding: 16rpx 40rpx; border-radius: 100rpx;
  font-size: 27rpx; font-weight: 700;
  background: var(--white); color: rgba(17,17,17,.65);
  border: 4rpx solid var(--ink);
  box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.14);
}
.chip.on { background: var(--ink); color: #FFFFFF; border-color: var(--ink); box-shadow: 6rpx 6rpx 0 var(--pink); }

/* ============ 按钮 ============ */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 108rpx; border-radius: 100rpx;
  font-size: 32rpx; font-weight: 800; letter-spacing: 6rpx; line-height: 1;
  border: var(--bd) solid var(--ink);
  box-shadow: 10rpx 10rpx 0 var(--ink);
}
.btn::after { border: none; }
.btn:active { transform: translate(6rpx, 6rpx); box-shadow: 2rpx 2rpx 0 var(--ink); }
.btn-cobalt { background: var(--pink); color: var(--ink); }
.btn-white  { background: var(--white);  color: var(--ink); }
.btn-verm   { background: var(--yellow); color: var(--ink); }
.btn-sm { height: 72rpx; font-size: 26rpx; letter-spacing: 2rpx; padding: 0 40rpx; box-shadow: 6rpx 6rpx 0 var(--ink); }
/* 满宽 + 文字强制单行：小程序 button 默认宽度自适应，长文案会被挤到换行 */
.btn-full { width: 100%; box-sizing: border-box; }
.btn-nowrap { white-space: nowrap; }

/* ============ 输入 ============ */
.field { margin-bottom: 36rpx; }
.field-l { display: block; font-size: 24rpx; color: rgba(17,17,17,.55); letter-spacing: 3rpx; margin-bottom: 14rpx; font-weight: 700; }
/* input 只给左右 padding：小程序 <input> 的文本垂直居中不跟随上下 padding，
   给了会导致文字忽上忽下。高度固定，由组件自身居中。 */
.field-i {
  background: var(--white); border: 5rpx solid var(--ink);
  border-radius: var(--r-md);
  box-shadow: 6rpx 6rpx 0 rgba(17,17,17,.12);
  padding: 0 32rpx;
  height: 112rpx; line-height: 108rpx;
  font-size: 32rpx; color: var(--ink);
  box-sizing: border-box;
}

/* ============ 空状态 ============ */
.empty { display: flex; flex-direction: column; align-items: center; padding: 70rpx 0; }
.empty-c { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--sky); border: 5rpx solid var(--ink); margin-bottom: 24rpx; }
.empty-t { font-size: 26rpx; color: rgba(17,17,17,.5); letter-spacing: 2rpx; }

/* ============ 底部操作条 ============ */
.bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 24rpx 40rpx 48rpx;
  background: linear-gradient(180deg, rgba(246,244,238,0) 0%, var(--paper) 36%);
}

/* ============ 通用 ============ */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.f1 { flex: 1; }
.mt-s { margin-top: 16rpx; } .mt-m { margin-top: 32rpx; } .mt-l { margin-top: 56rpx; }

